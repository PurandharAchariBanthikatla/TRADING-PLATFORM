# Copy to .env at the repo root before running scripts/docker-run.sh.
# This file feeds every backend container via --env-file (api-gateway,
# ledger-service, and so on); individual services also ship their own
# .env.example for running outside Docker. JWT_SECRET_KEY/JWT_ALGORITHM in
# particular MUST be shared across every service byte-for-byte: api-gateway
# is the only service that issues tokens, every other internal service only
# verifies signatures against this same secret.

ENVIRONMENT=development
SERVICE_NAME=api-gateway
LOG_LEVEL=INFO

# Overridden by scripts/docker-run.sh to point at the container names on the
# exchange-net Docker network -- set here only for reference / non-Docker use.
DATABASE_URL=postgresql+asyncpg://exchange:exchange@localhost:5432/exchange
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30

REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Shared secret for internal service-to-service calls (e.g. wallet-service
# -> ledger-service). Same value goes into every backend service's env.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
INTERNAL_SERVICE_KEY=CHANGE_ME_IN_PRODUCTION

BCRYPT_ROUNDS=12

RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_ATTEMPTS=3
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600

CORS_ORIGINS=http://localhost:3000

API_V1_PREFIX=/api/v1

# Paper-funds withdrawal limits (wallet-service). See
# services/wallet-service/app/core/config.py for why these are flat today.
MAX_WITHDRAWAL_PER_TRANSACTION=10000
MAX_WITHDRAWAL_PER_DAY=25000

# Market-data-service. REDIS_URL above is overridden to redis://<redis>:6379/1
# for this service by scripts/docker-run.sh (separate logical DB index from
# api-gateway's rate-limit usage on /0). See
# services/market-data-service/app/core/event_bus.py for why Redis Streams
# stands in for Kafka/Redpanda here.
SIMULATOR_ENABLED=true
SIMULATOR_TICK_INTERVAL_SECONDS=1.0
SIMULATOR_SEED=1337
EVENT_STREAM_MAX_DELIVERY_ATTEMPTS=5
EVENT_STREAM_CLAIM_MIN_IDLE_MS=30000
EVENT_STREAM_MAXLEN_APPROX=100000
TICKER_CACHE_TTL_SECONDS=5
