ENVIRONMENT=development
SERVICE_NAME=wallet-service
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://exchange:exchange@localhost:5432/exchange
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30

# MUST be identical to api-gateway's JWT_SECRET_KEY/JWT_ALGORITHM.
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256

# Same value as ledger-service's INTERNAL_SERVICE_KEY -- wallet-service is
# a *caller* of that mechanism here (see app/clients/ledger_client.py).
INTERNAL_SERVICE_KEY=CHANGE_ME_IN_PRODUCTION
LEDGER_SERVICE_BASE_URL=http://localhost:8010/api/v1
LEDGER_CLIENT_TIMEOUT_SECONDS=10.0

API_V1_PREFIX=/api/v1

MAX_WITHDRAWAL_PER_TRANSACTION=10000
MAX_WITHDRAWAL_PER_DAY=25000
