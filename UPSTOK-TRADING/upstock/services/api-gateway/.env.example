# Copy to .env for local (non-Docker) development.
# In Docker/staging/production these are injected by the orchestrator /
# secrets manager -- never bake real values into the image.

ENVIRONMENT=development
SERVICE_NAME=api-gateway
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://exchange:exchange@localhost:5432/exchange
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30

REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

BCRYPT_ROUNDS=12

RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_REGISTER_ATTEMPTS=3
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600

CORS_ORIGINS=http://localhost:3000

API_V1_PREFIX=/api/v1

# Used only by tests (see tests/conftest.py); a separate scratch database.
TEST_DATABASE_URL=postgresql+asyncpg://exchange:exchange@localhost:5432/exchange_test
