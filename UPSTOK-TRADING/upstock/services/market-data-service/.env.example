ENVIRONMENT=development
SERVICE_NAME=market-data-service
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://exchange:exchange@localhost:5432/exchange
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30

# MUST be identical to api-gateway's JWT_SECRET_KEY/JWT_ALGORITHM.
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256

# Same value as every other backend service's INTERNAL_SERVICE_KEY.
INTERNAL_SERVICE_KEY=CHANGE_ME_IN_PRODUCTION

API_V1_PREFIX=/api/v1

# Event bus backing store -- see app/core/event_bus.py for why Redis
# Streams stands in for Kafka/Redpanda here.
REDIS_URL=redis://localhost:6379/1
EVENT_STREAM_MAX_DELIVERY_ATTEMPTS=5
EVENT_STREAM_CLAIM_MIN_IDLE_MS=30000
EVENT_STREAM_MAXLEN_APPROX=100000

# Paper market-data simulator -- phase 3 stand-in for real matching-engine
# trades. Disable once phase 4 produces real trades onto the same streams.
SIMULATOR_ENABLED=true
SIMULATOR_TICK_INTERVAL_SECONDS=1.0
SIMULATOR_SEED=1337

TICKER_CACHE_TTL_SECONDS=5
