ENVIRONMENT=development
SERVICE_NAME=ledger-service
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://exchange:exchange@localhost:5432/exchange
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30

# MUST be identical to api-gateway's JWT_SECRET_KEY/JWT_ALGORITHM -- this
# service verifies tokens minted there, it does not issue its own.
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256

# Shared secret for trusted internal services (wallet-service, later the
# matching/risk/settlement services) calling POST /ledger/transactions on a
# user's behalf. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
INTERNAL_SERVICE_KEY=CHANGE_ME_IN_PRODUCTION

API_V1_PREFIX=/api/v1
MAX_ENTRIES_PER_TRANSACTION=32
